{
    "name": "arodu/cakephp-modal-form",
    "description": "ModalForm plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "cakephp/authentication": "^3.0",
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "ModalForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModalForm\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
